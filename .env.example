# Copy to .env and fill in. .env is git-ignored; never commit a real token.

# DataHub connection — GMS API, not the UI port.
# Local quickstart: UI is http://localhost:9002, GMS is http://localhost:8080
DATAHUB_GMS_URL=http://localhost:8080
# Optional on a default OSS quickstart, which ships with metadata-service auth off.
DATAHUB_GMS_TOKEN=

# DataHub MCP server flags (Fuse needs mutations for the write-back step)
TOOLS_IS_MUTATION_ENABLED=true
TOOLS_IS_USER_ENABLED=true

# LLM provider: openrouter | anthropic | openai | ollama | none
# "none" disables the LLM nodes and falls back to deterministic templates, so the
# pipeline still completes without any API key.
#
# openrouter is the recommended option: open-weight models (GLM, Qwen, DeepSeek) at no
# cost on the free tier — 20 requests/minute, 50/day, and a Fuse run makes 1-4 calls.
# Get a key at https://openrouter.ai/keys, then run `fuse models` to see which ids are
# free today; the `:free` list changes without notice.
FUSE_LLM_PROVIDER=none
FUSE_LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b

# Behaviour
FUSE_HOPS=3
FUSE_SCHEMA_PROBE_HOPS=2
FUSE_FAIL_ON=BREAKING
FUSE_DIALECT=snowflake
