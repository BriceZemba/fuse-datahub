# DataHub connection — GMS API, not the UI port.
# Local quickstart: UI is http://localhost:9002, GMS is http://localhost:8080
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# DataHub MCP server flags (Fuse needs mutations for the write-back step)
TOOLS_IS_MUTATION_ENABLED=true
TOOLS_IS_USER_ENABLED=true

# LLM provider: anthropic | openai | ollama | none
# "none" disables the LLM nodes and falls back to deterministic templates,
# so the pipeline still completes without any API key.
FUSE_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b

# Behaviour
FUSE_HOPS=3
FUSE_FAIL_ON=BREAKING
FUSE_DIALECT=snowflake
