"""Backfill for {{ consumer }} after `{{ column }}` was removed from {{ model }}.

Generated by Fuse. Impacted asset: {{ urn }}

Run against the warehouse in a maintenance window; it is idempotent and restates
only the partitions that referenced the removed column.
"""

from __future__ import annotations

import argparse
import logging

MODEL = "{{ model }}"
REMOVED_COLUMN = "{{ column }}"
TARGET_URN = "{{ urn }}"

log = logging.getLogger("backfill")


def partitions_to_restate(conn, start: str, end: str) -> list[str]:
    cursor = conn.cursor()
    cursor.execute(
        f"select distinct to_char(updated_at, 'YYYY-MM-DD') as p "
        f"from {MODEL} where updated_at between %s and %s order by p",
        (start, end),
    )
    return [row[0] for row in cursor.fetchall()]


def restate(conn, partition: str) -> None:
    log.info("restating %s partition %s", MODEL, partition)
    cursor = conn.cursor()
    cursor.execute(
        f"delete from {MODEL}_restated where partition_date = %s", (partition,)
    )
    cursor.execute(
        f"insert into {MODEL}_restated "
        f"select * from {MODEL} where to_char(updated_at, 'YYYY-MM-DD') = %s",
        (partition,),
    )
    conn.commit()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--start", required=True, help="YYYY-MM-DD")
    parser.add_argument("--end", required=True, help="YYYY-MM-DD")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    conn = get_connection()  # TODO: wire to your warehouse connection helper
    partitions = partitions_to_restate(conn, args.start, args.end)
    log.info("%d partition(s) to restate", len(partitions))
    for partition in partitions:
        if args.dry_run:
            log.info("[dry-run] would restate %s", partition)
        else:
            restate(conn, partition)


def get_connection():
    raise NotImplementedError(
        "Point this at your warehouse connection helper before running."
    )


if __name__ == "__main__":
    main()
